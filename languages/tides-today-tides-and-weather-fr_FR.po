msgstr "Apercu en direct"

msgid "The preview updates after you choose a location and whenever you change the widget options."
msgstr "L'apercu se met a jour apres le choix d'un lieu et chaque fois que vous modifiez les options du widget."

msgid "Usage"
msgstr "Utilisation"

msgid "Use this shortcode anywhere shortcodes are supported:"
msgstr "Utilisez ce shortcode partout ou les shortcodes sont pris en charge :"

msgid "The same saved widget will also appear in the classic Widgets screen and in the Gutenberg block dropdown."
msgstr "Le meme widget enregistre apparaitra aussi dans l'ecran classique des widgets et dans la liste deroulante des blocs Gutenberg."

msgid "Once your widget has been saved, usage instructions will appear here."
msgstr "Une fois votre widget enregistre, les instructions d'utilisation apparaitront ici."

msgid "You do not have permission to save Tides Today widgets."
msgstr "Vous n'avez pas l'autorisation d'enregistrer les widgets Tides Today."

msgid "Please complete every required field before saving."
msgstr "Veuillez remplir tous les champs obligatoires avant d'enregistrer."

msgid "Widget names must be unique."
msgstr "Les noms des widgets doivent etre uniques."

msgid "The selected country is no longer available."
msgstr "Le pays selectionne n'est plus disponible."

msgid "The selected region is no longer available."
msgstr "La region selectionnee n'est plus disponible."

msgid "The selected location is no longer available."
msgstr "Le lieu selectionne n'est plus disponible."

msgid "You do not have permission to delete Tides Today widgets."
msgstr "Vous n'avez pas l'autorisation de supprimer les widgets Tides Today."

msgid "Saved Tides Today widget not found."
msgstr "Widget Tides Today enregistre introuvable."

msgid "Unknown proxy script requested."
msgstr "Le script proxy demande est inconnu."

msgid "Tides Today Tides and Weather requires PHP %1$s or newer. You are running %2$s."
msgstr "Tides Today Marees et meteo exige PHP %1$s ou plus recent. Vous utilisez %2$s."

msgid "Tides Today Tides and Weather requires WordPress %1$s or newer. You are running %2$s."
msgstr "Tides Today Marees et meteo exige WordPress %1$s ou plus recent. Vous utilisez %2$s."

msgid "The PHP JSON extension is required."
msgstr "L'extension PHP JSON est requise."

msgid "Either the PHP cURL or OpenSSL extension is required to fetch Tides Today data over HTTPS."
msgstr "L'extension PHP cURL ou OpenSSL est requise pour recuperer les donnees Tides Today via HTTPS."

msgid "Tides Today returned invalid JSON."
msgstr "Tides Today a renvoye un JSON invalide."

msgid "The Tides Today service could not be reached."
msgstr "Le service Tides Today est inaccessible."

msgid "Tides Today returned an unexpected response."
msgstr "Tides Today a renvoye une reponse inattendue."

msgid "A complete preview location was not provided."
msgstr "Un lieu d'apercu complet n'a pas ete fourni."

msgid "Widget saved successfully."
msgstr "Widget enregistre avec succes."

msgid "Widget deleted successfully."
msgstr "Widget supprime avec succes."

msgid "Something went wrong."
msgstr "Un probleme est survenu."

msgid "Visit Tides Today"
msgstr "Visiter Tides Today"

msgid "Find on Facebook"
msgstr "Retrouver sur Facebook"

msgid "Follow on X"
msgstr "Suivre sur X"

msgid "Subscribe on Youtube"
msgstr "S'abonner sur YouTube"

msgid "Follow on Instagram"
msgstr "Suivre sur Instagram"

